# TRON Nile 테스트넷 (메인넷 URL 은 스크립트가 거부)
NILE_RPC_URL=https://nile.trongrid.io
# 금고 오너(=사용자) 개인키. 정책 설정·최종 승인(approveSpend)·긴급 중지 해제 권한
PRIVATE_KEY=your_private_key_here
# 긴급 중지 권한만 가진 가디언 주소 (선택, 비우면 비활성)
GUARDIAN_ADDRESS=your_guardian_address_here
# AI 에이전트 지갑. 오너와 달라야 함 → `npm run setup:agent` 가 생성·충전·기록
AI_AGENT_ADDRESS=your_agent_address_here
AI_AGENT_PRIVATE_KEY=

# --- optional ---
# 배포 트랜잭션 수수료 상한 (TRX)
FEE_LIMIT_TRX=1000
# 데모 호출 1건당 수수료 상한 (TRX)
CALL_FEE_LIMIT_TRX=150
# setup:agent 충전 기준 (TRX)
AGENT_MIN_TRX=50
AGENT_FUND_TRX=100
